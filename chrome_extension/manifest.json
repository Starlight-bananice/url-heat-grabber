{
  "manifest_version": 3,
  "name": "链接热度抓取",
  "version": "0.7.4",
  "minimum_chrome_version": "120",
  "description": "在当前已登录的小红书 Chrome 中，通过独立后台标签页为本机工具抓取链接状态与互动数据。",
  "key": "",
  "permissions": [
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.xiaohongshu.com/*",
    "http://127.0.0.1:18739/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "链接热度抓取"
  }
}
